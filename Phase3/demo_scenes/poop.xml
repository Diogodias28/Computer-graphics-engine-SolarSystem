<world>
    <window width="800" height="600" />
    <camera> 
        <position x="5" y="2.5" z="5" />
        <lookAt x="0" y="1" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="60" near="1" far="1000" />
    </camera>

    <!-- Main Group containing everything -->
    <group>
        <!-- Ground -->
        <group>
            <transform>
                <translate x="0" y="-0.1" z="0" />
                <scale x="8" y="0.1" z="8" />
            </transform>
            <models>
                <model file="box_1_8.3d" /> <!-- generator box 1 8 box_1_8.3d -->
            </models>
        </group>

        <!-- Dog Body -->
        <group>
            <transform>
                <translate x="0" y="1" z="0" />
                <scale x="1.2" y="0.8" z="1.8" />
            </transform>
            <models>
                <model file="sphere_1_16_16.3d" /> <!-- generator sphere 1 16 16 sphere_1_16_16.3d -->
            </models>
        </group>

        <!-- Head -->
        <group>
            <transform>
                <translate x="0" y="1.4" z="1.3" />
                <scale x="0.9" y="0.8" z="0.9" />
            </transform>
            <models>
                <model file="sphere_1_12_12.3d" /> <!-- generator sphere 1 12 12 sphere_1_12_12.3d -->
            </models>
        </group>

        <!-- Snout -->
        <group>
            <transform>
                <translate x="0" y="1.3" z="1.9" />
                <scale x="0.5" y="0.4" z="0.7" />
            </transform>
            <models>
                <model file="sphere_1_10_10.3d" /> <!-- generator sphere 1 10 10 sphere_1_10_10.3d -->
            </models>
        </group>

        <!-- Nose -->
        <group>
            <transform>
                <translate x="0" y="1.3" z="2.4" />
                <scale x="0.2" y="0.15" z="0.15" />
            </transform>
            <models>
                <model file="sphere_1_8_8.3d" /> <!-- generator sphere 1 8 8 sphere_1_8_8.3d -->
            </models>
        </group>

        <!-- Left Ear -->
        <group>
            <transform>
                <translate x="0.5" y="1.9" z="1.3" />
                <rotate angle="-30" x="1" y="0" z="1" />
                <scale x="0.3" y="0.5" z="0.2" />
            </transform>
            <models>
                <model file="sphere_1_8_8.3d" /> <!-- generator sphere 1 8 8 sphere_1_8_8.3d -->
            </models>
        </group>

        <!-- Right Ear -->
        <group>
            <transform>
                <translate x="-0.5" y="1.9" z="1.3" />
                <rotate angle="30" x="1" y="0" z="-1" />
                <scale x="0.3" y="0.5" z="0.2" />
            </transform>
            <models>
                <model file="sphere_1_8_8.3d" /> <!-- generator sphere 1 8 8 sphere_1_8_8.3d -->
            </models>
        </group>

        <!-- Left Eye -->
        <group>
            <transform>
                <translate x="0.25" y="1.55" z="1.7" />
                <scale x="0.1" y="0.1" z="0.1" />
            </transform>
            <models>
                <model file="sphere_1_8_8.3d" /> <!-- generator sphere 1 8 8 sphere_1_8_8.3d -->
            </models>
        </group>

        <!-- Right Eye -->
        <group>
            <transform>
                <translate x="-0.25" y="1.55" z="1.7" />
                <scale x="0.1" y="0.1" z="0.1" />
            </transform>
            <models>
                <model file="sphere_1_8_8.3d" /> <!-- generator sphere 1 8 8 sphere_1_8_8.3d -->
            </models>
        </group>

        <!-- Neck -->
        <group>
            <transform>
                <translate x="0" y="1.1" z="0.7" />
                <scale x="0.7" y="0.6" z="0.6" />
            </transform>
            <models>
                <model file="sphere_1_8_8.3d" /> <!-- generator sphere 1 8 8 sphere_1_8_8.3d -->
            </models>
        </group>

        <!-- Tail -->
        <group>
            <transform>
                <translate x="0" y="1.5" z="-1.0" />
                <rotate angle="-30" x="1" y="0" z="0" />
                <scale x="0.2" y="0.2" z="0.7" />
            </transform>
            <models>
                <model file="cone_1_2_8_4.3d" /> <!-- generator cone 1 2 8 4 cone_1_2_8_4.3d -->
            </models>
        </group>

        <!-- Front Right Leg -->
        <group>
            <transform>
                <translate x="0.5" y="0.4" z="0.6" />
                <scale x="0.2" y="0.7" z="0.2" />
            </transform>
            <models>
                <model file="box_1_4.3d" /> <!-- generator box 1 4 box_1_4.3d -->
            </models>
        </group>

        <!-- Front Left Leg -->
        <group>
            <transform>
                <translate x="-0.5" y="0.4" z="0.6" />
                <scale x="0.2" y="0.7" z="0.2" />
            </transform>
            <models>
                <model file="box_1_4.3d" /> <!-- generator box 1 4 box_1_4.3d -->
            </models>
        </group>

        <!-- Back Right Leg in squatting position -->
        <group>
            <transform>
                <translate x="0.5" y="0.6" z="-0.6" />
                <rotate angle="30" x="1" y="0" z="0" />
                <scale x="0.2" y="0.7" z="0.2" />
            </transform>
            <models>
                <model file="box_1_4.3d" /> <!-- generator box 1 4 box_1_4.3d -->
            </models>
        </group>

        <!-- Back Left Leg in squatting position -->
        <group>
            <transform>
                <translate x="-0.5" y="0.6" z="-0.6" />
                <rotate angle="30" x="1" y="0" z="0" />
                <scale x="0.2" y="0.7" z="0.2" />
            </transform>
            <models>
                <model file="box_1_4.3d" /> <!-- generator box 1 4 box_1_4.3d -->
            </models>
        </group>

        <!-- Poop (coming out) -->
        <group>
            <transform>
                <translate x="0" y="0.9" z="-0.8" />
                <scale x="0.3" y="0.3" z="0.3" />
            </transform>
            <models>
                <model file="sphere_1_8_8.3d" /> <!-- generator sphere 1 8 8 sphere_1_8_8.3d -->
            </models>
        </group>

        <!-- Poop (on ground) -->
        <group>
            <transform>
                <translate x="0" y="0.2" z="-1.0" />
                <scale x="0.25" y="0.2" z="0.25" />
            </transform>
            <models>
                <model file="sphere_1_8_8.3d" /> <!-- generator sphere 1 8 8 sphere_1_8_8.3d -->
            </models>
        </group>
    </group>
</world>