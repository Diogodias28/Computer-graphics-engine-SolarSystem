<world> 
    <window width="800" height="600" />
    <camera> 
        <position x="30" y="40" z="80" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="30" near="1" far="1000" />
    </camera>

    <!-- Sun and planets system -->
    <group>
        <!-- Sun (center of the system) -->
        <transform>
            <scale x="100" y="100" z="100" />
        </transform>
        <models>
            <model file="sphere.3d" /> <!-- Generate a sphere with radius 1 -->
        </models>
        <transform>
            <scale x="1/100" y="1/100" z="1/100" />
        </transform>        
            <!-- Mercury -->
        <group>
            <transform>
                <translate x="157" y="0" z="0" />
                <scale x="4" y="4" z="4" />
            </transform>
            <models>
                <model file="sphere.3d" />
            </models>
        </group>

        <!-- Venus -->
        <group>
            <transform>
                <translate x="55" y="0" z="0" />
                <scale x="4.5" y="4.5" z="4.5" />
            </transform>
            <models>
                <model file="sphere.3d" />
            </models>
        </group>

        <!-- Earth with Moon -->
        <group>
            <transform>
                <translate x="65" y="0" z="0" />
            </transform>
            <group>
                <transform>
                    <scale x="5" y="5" z="5" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
            <!-- Moon orbiting Earth -->
            <group>
                <transform>
                    <translate x="2" y="0" z="0" />
                    <scale x="1" y="1" z="1" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
        </group>

        <!-- Mars with its moons -->
        <group>
            <transform>
                <translate x="60" y="0" z="0" />
                <scale x="2.5" y="2.5" z="2.5" />
            </transform>
            <models>
                <model file="sphere.3d" />
            </models>
            <!-- Phobos -->
            <group>
                <transform>
                    <translate x="1" y="0" z="0" />
                    <scale x="0.75" y="0.75" z="0.75" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
            <!-- Deimos -->
            <group>
                <transform>
                    <translate x="0" y="0" z="1.5" />
                    <scale x="0.65" y="0.65" z="0.65" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
        </group>

        <!-- Jupiter with some of its moons -->
        <group>
            <transform>
                <translate x="80" y="0" z="0" />
                <scale x="12" y="12" z="12" />
            </transform>
            <models>
                <model file="sphere.3d" />
            </models>
            <!-- Io -->
            <group>
                <transform>
                    <translate x="1.5" y="0" z="0" />
                    <scale x="0.15" y="0.15" z="0.15" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
            <!-- Europa -->
            <group>
                <transform>
                    <translate x="0" y="0" z="2" />
                    <scale x="0.15" y="0.15" z="0.15" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
            <!-- Ganymede -->
            <group>
                <transform>
                    <translate x="-1.8" y="0" z="0" />
                    <scale x="0.15" y="0.15" z="0.15" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
        </group>

        <!-- Saturn with rings -->
        <group>
            <transform>
                <translate x="100" y="0" z="0" />
                <scale x="10" y="10" z="10" />
            </transform>
            <models>
                <model file="sphere.3d" />
            </models>
            <!-- Saturn's rings -->
            <group>
                <transform>
                    <rotate angle="90" x="1" y="0" z="0" />
                    <scale x="3" y="3" z="0.1" />
                </transform>
                <models>
                    <model file="ring.3d" /> <!-- This will be a flat ring -->
                </models>
            </group>
            <!-- Titan -->
            <group>
                <transform>
                    <translate x="3" y="0" z="0" />
                    <scale x="0.2" y="0.2" z="0.2" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
        </group>

        <!-- Uranus -->
        <group>
            <transform>
                <translate x="120" y="0" z="0" />
                <scale x="7" y="7" z="7" />
            </transform>
            <models>
                <model file="sphere.3d" />
            </models>
        </group>

        <!-- Neptune -->
        <group>
            <transform>
                <translate x="140" y="0" z="0" />
                <scale x="6.5" y="6.5" z="6.5" />
            </transform>
            <models>
                <model file="sphere.3d" />
            </models>
        </group>
    </group>
</world>
